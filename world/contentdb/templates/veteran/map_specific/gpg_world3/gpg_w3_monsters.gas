		  damage_min = 326.5;
	}
	[body]
	{
		min_move_velocity = 1.75;
		avg_move_velocity = 2;
	}
	[common]
	{
		screen_name = "Krug Chieftain";
		membership = krug, monster;
	}
	[defend]
	{
		  defense = 593.5;
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				  es_weapon_hand = ax_d_d_2h1b_avg;
			}
    		[oneof*]
			{
				[all*]
				{
					[gold*]
					{
						  chance = 0.2;
						  max = 65904;
						  min = 49996;
					}
				}
				[oneof*]
				{
					[all*]
					{
        				chance = 0.01;
    	        	    il_main = #spell/12-23;
					}
					[all*]
					{
        				chance = 0.02;
    	        	    il_main = #spell/29-58;
					}
					[all*]
					{
					    chance = 0.20;
		           	    il_main = #weapon/144-182;
		                il_main = #armor/76-425;
		    			il_main = potion_mana_large;
						il_main = potion_health_large;
                    }
                    [oneof*]
					{
	                   	chance = 0.004;
	                   	il_main = #weapon/-rare(1)/177-243;
	                   	il_main = #armor/-rare(1)/320-576;
                       	il_main = #*/-rare(1)/177-243;
                	}
					[oneof*]
					{
                       	chance = 0.002;
	                   	il_main = #weapon/-unique(2)/177-243;
	                   	il_main = #armor/-unique(2)/320-576;
                       	il_main = #*/-unique(2)/177-243;
                    }
				}
			}
		}
	}
	[mind]
	{
		jat_fidget						= world\ai\jobs\common\job_fidget.skrit
			?social							= 0.35
			&still							= false;

		jat_brain							= world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party			= true
			&form_party_on_friend_entered_ICZ	= true
			&form_party_on_friend_entered_OCZ	= true
			&party_template						= "party_krug_commander";
		on_enemy_spotted_alert_friends			= true;
	}
	[physics]
	{
		  break_sound = s_e_meat_explosion;
		  explosion_magnitude = 1.5;
		[break_particulate]
		{
			gpg_frag_glb_krug_commander_fire_01 = 1;
			gpg_frag_glb_krug_commander_fire_02 = 1;
			gpg_frag_glb_krug_commander_fire_03 = 1;
			gpg_frag_glb_krug_commander_fire_04 = 1;
			gpg_frag_glb_krug_commander_fire_05 = 1;
			gpg_frag_glb_krug_commander_fire_06 = 1;
			gpg_frag_glb_krug_commander_fire_07 = 1;
			gpg_frag_glb_krug_commander_fire_08 = 1;
		}
	}
}
